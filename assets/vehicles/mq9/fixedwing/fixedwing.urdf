<?xml version="1.0" ?>

<!--
  MQ-9 "Reaper" cosmetic skin for PyFlyt's stock fixed-wing model.

  This file is currently a byte-for-byte functional copy of PyFlyt's stock
  fixedwing.urdf (box primitives, no flight-dynamics changes). It exists so
  the visuals can be swapped for a real MQ-9 mesh later WITHOUT touching
  physics: <inertial> and <collision> blocks (which drive the sim) must stay
  exactly as-is.

  TO SWAP IN A REAL MQ-9 MESH ONCE ONE IS DOWNLOADED:
    1. Drop the mesh file(s) (.obj/.stl/.dae) into:
         assets/vehicles/mq9/fixedwing/meshes/
    2. In each <visual><geometry> block below (marked "VISUAL - swap here"),
       replace the <box size="..."/> line with, e.g.:
         <mesh filename="meshes/mq9.obj" scale="1 1 1"/>
       Leave the <collision><geometry> blocks (boxes) untouched - collision
       shapes are physics, not skin.
    3. One mesh covering the whole airframe is simplest: put it on the
       fuselage_link visual and leave the other links' visuals empty/hidden
       (or delete their <visual> blocks) to avoid double-rendering.
-->

<robot name="fixedwing">

  <material name="blue">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="invisible">
    <!-- pybullet renders a link's collision shape as a fallback when no
         <visual> is present, so a link that should be hidden (its shape is
         part of the single MQ-9 mesh on fuselage_link instead) still needs
         an explicit, fully-transparent <visual> rather than none at all. -->
    <color rgba="0.0 0.0 0.0 0.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>


  <link name="motor_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="motor_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="motor_link"/>
  </joint>


  <link name="horizontal_tail_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.3 0.6 0.05"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <box size="0.3 0.6 0.05"/>
      </geometry>
      <material name="invisible"/>
    </visual>
  </link>
  <joint name="horizontal_tail_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-1.1 0 0"/>
    <parent link="base_link"/>
    <child link="horizontal_tail_link"/>
  </joint>


  <link name="vertical_tail_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.3 0.05 0.3"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <box size="0.3 0.05 0.3"/>
      </geometry>
      <material name="invisible"/>
    </visual>
  </link>
  <joint name="vertical_tail_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-1.1 0 0.15"/>
    <parent link="base_link"/>
    <child link="vertical_tail_link"/>
  </joint>


  <link name="ail_left_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.31 0.3 0.06"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <box size="0.31 0.3 0.06"/>
      </geometry>
      <material name="invisible"/>
    </visual>
  </link>
  <joint name="ail_left_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.5 0.95 0"/>
    <parent link="base_link"/>
    <child link="ail_left_link"/>
  </joint>


  <link name="ail_right_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.31 0.3 0.06"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <box size="0.31 0.3 0.06"/>
      </geometry>
      <material name="invisible"/>
    </visual>
  </link>
  <joint name="ail_right_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.5 -0.95  0"/>
    <parent link="base_link"/>
    <child link="ail_right_link"/>
  </joint>


  <link name="main_wing_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.3 1.8 0.05"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <box size="0.3 1.8 0.05"/>
      </geometry>
      <material name="invisible"/>
    </visual>
  </link>
  <joint name="main_wing_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.5 0 0"/>
    <parent link="base_link"/>
    <child link="main_wing_link"/>
  </joint>


  <link name="fuselage_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="1.4 0.2 0.2"/>
      </geometry>
    </collision>
    <visual>
      <!-- Real MQ-9 mesh (downloaded .obj, free asset). The mesh's long axis
           came out of the file along its own X; that's the wingspan here, so
           it's rotated 90deg yaw to align with this model's spanwise Y axis.
           Scale maps the mesh's ~115-unit wingspan down to this model's 1.8m
           physics wingspan (see main_wing_link's box size above); origin
           recenters the mesh's bounding box on the link origin. First-pass
           placement -- nose direction/centering may want a visual tweak once
           someone can actually look at it rendered. -->
      <origin rpy="0 0 1.5708" xyz="0.07872255 0.02074486 -0.18056071"/>
      <geometry>
        <mesh filename="meshes/mq9.obj" scale="0.01557363 0.01557363 0.01557363"/>
      </geometry>
    </visual>
  </link>
  <joint name="fuselage_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.45 0 0"/>
    <parent link="base_link"/>
    <child link="fuselage_link"/>
  </joint>

</robot>
